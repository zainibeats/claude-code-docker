## Required. Full path to the directory you want the agent to work in.
## It is mounted at this same path inside the container, so paths match the host.
PATH_TO_WORKSPACE=/home/john/workspace

## Match the container user to your host user so bind-mounted files keep the
## right ownership. Run `id -u` and `id -g` on the host and paste the values.
HOST_UID=1000
HOST_GID=1000

## Git identity configured inside the container at startup
GIT_USER_NAME=Agent User
GIT_USER_EMAIL=agent@example.com

## Which agent CLI to install at build time. Change and re-run `docker compose build`.
##   @anthropic-ai/claude-code | @openai/codex | @google/gemini-cli
## Space-separated values install more than one.
AGENT_PACKAGES=@anthropic-ai/claude-code

## Local timezone, so timestamps in logs and commits match the host.
TZ=UTC

## Container username, and whether it gets passwordless sudo (1 = yes).
AGENT_USER=agent
AGENT_SUDO=1

## macOS only: Docker Desktop exposes the host SSH agent at a fixed path.
# SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock

## Provider credentials. Leave blank to authenticate interactively inside the
## container instead -- with the agent-home volume, that login persists.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

## Token for `gh` and for git pushes over HTTPS.
GH_TOKEN=
